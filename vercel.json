{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "source": "/contact.php",
      "destination": "/api/contact.php"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/api/index.php"
    }
  ]
}
